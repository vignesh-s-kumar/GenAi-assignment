<script>
// ---------- Shared flags ----------
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

// ---------- Hero name split-letter animation ----------
const heroName = document.getElementById('heroName');
const words = ["VIGNESH", "KUMAR", "S"];
let delay = 0;
words.forEach((word) => {
  const wordSpan = document.createElement('span');
  wordSpan.className = 'word';
  [...word].forEach((ch) => {
    const charSpan = document.createElement('span');
    charSpan.className = 'char';
    charSpan.textContent = ch;
    charSpan.style.animationDelay = delay + 's';
    delay += 0.045;
    wordSpan.appendChild(charSpan);
  });
  heroName.appendChild(wordSpan);
  delay += 0.08;
});

// ---------- Cursor glow + shared normalized mouse position ----------
const glow = document.getElementById('cursorGlow');
window.addEventListener('mousemove', (e) => {
  glow.style.left = e.clientX + 'px';
  glow.style.top = e.clientY + 'px';
  mouseNX = (e.clientX / window.innerWidth) * 2 - 1;
  mouseNY = (e.clientY / window.innerHeight) * 2 - 1;
}, { passive: true });
window.addEventListener('mouseleave', () => { glow.style.opacity = '0'; });
window.addEventListener('mouseenter', () => { glow.style.opacity = '1'; });

// ---------- 3D tilt on the terminal panel ----------
if (!reduceMotion){
  const tiltPanel = document.getElementById('terminalPanel');
  const tiltStage = tiltPanel.closest('.tilt-stage');
  tiltStage.addEventListener('mousemove', (e) => {
    const r = tiltPanel.getBoundingClientRect();
    const px = (e.clientX - r.left) / r.width - 0.5;
    const py = (e.clientY - r.top) / r.height - 0.5;
    tiltPanel.style.transform = `rotateX(${(-py * 10).toFixed(2)}deg) rotateY(${(px * 12).toFixed(2)}deg)`;
  });
  tiltStage.addEventListener('mouseleave', () => {
    tiltPanel.style.transform = 'rotateX(0deg) rotateY(0deg)';
  });
}

// ---------- Real-time 3D background (Three.js) ----------
const canvas3d = document.getElementById('bg-canvas');
let mouseNX = 0, mouseNY = 0; // normalized -1..1, shared with tilt/parallax below

(function initThree(){
  const renderer = new THREE.WebGLRenderer({ canvas: canvas3d, alpha: true, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(50, window.innerWidth/window.innerHeight, 0.1, 100);
  camera.position.z = 9;

  // Wireframe icosahedron — crisp edges, not the default diagonal wireframe
  const icoGeo = new THREE.IcosahedronGeometry(3.1, 1);
  const edges = new THREE.EdgesGeometry(icoGeo);
  const icoMat = new THREE.LineBasicMaterial({ color: 0xff4b3e, transparent: true, opacity: 0.32 });
  const ico = new THREE.LineSegments(edges, icoMat);
  scene.add(ico);

  const icoGeo2 = new THREE.IcosahedronGeometry(2.15, 1);
  const edges2 = new THREE.EdgesGeometry(icoGeo2);
  const icoMat2 = new THREE.LineBasicMaterial({ color: 0xc9a24b, transparent: true, opacity: 0.22 });
  const ico2 = new THREE.LineSegments(edges2, icoMat2);
  scene.add(ico2);

  // Sparse 3D particle field
  const particleCount = 240;
  const positions = new Float32Array(particleCount * 3);
  for (let i = 0; i < particleCount; i++){
    const r = 6 + Math.random() * 6;
    const theta = Math.random() * Math.PI * 2;
    const phi = Math.acos((Math.random() * 2) - 1);
    positions[i*3]   = r * Math.sin(phi) * Math.cos(theta);
    positions[i*3+1] = r * Math.sin(phi) * Math.sin(theta);
    positions[i*3+2] = r * Math.cos(phi);
  }
  const particleGeo = new THREE.BufferGeometry();
  particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  const particleMat = new THREE.PointsMaterial({ color: 0xd81324, size: 0.045, transparent: true, opacity: 0.55 });
  const points = new THREE.Points(particleGeo, particleMat);
  scene.add(points);

  function resize3d(){
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  }
  window.addEventListener('resize', resize3d);

  function animate3d(){
    ico.rotation.x += 0.0016;
    ico.rotation.y += 0.0024;
    ico2.rotation.x -= 0.0011;
    ico2.rotation.y -= 0.0017;
    points.rotation.y += 0.0006;

    // subtle camera parallax driven by cursor position
    camera.position.x += (mouseNX * 1.4 - camera.position.x) * 0.03;
    camera.position.y += (-mouseNY * 1.0 - camera.position.y) * 0.03;
    camera.lookAt(0, 0, 0);

    renderer.render(scene, camera);
    if (!reduceMotion) requestAnimationFrame(animate3d);
  }
  animate3d();
})();

// ---------- Scroll reveal + rail nav sync ----------
const revealEls = document.querySelectorAll('.reveal');
const io = new IntersectionObserver((entries) => {
  entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('in'); });
}, { threshold: 0.2 });
revealEls.forEach(el => io.observe(el));

const railLinks = document.querySelectorAll('.rail a');
const sectionEls = document.querySelectorAll('section');
const navIO = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting){
      const id = entry.target.getAttribute('id');
      railLinks.forEach(l => l.classList.toggle('active', l.getAttribute('href') === '#'+id));
    }
  });
}, { threshold: 0.5 });
sectionEls.forEach(s => navIO.observe(s));

// ---------- Terminal typewriter (scrollytelling) ----------
const termLines = document.querySelectorAll('#termBody .line');
let termPlayed = false;
const termIO = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting && !termPlayed){
      termPlayed = true;
      termLines.forEach((line, i) => {
        setTimeout(() => { line.style.opacity = '1'; }, i * 260);
      });
    }
  });
}, { threshold: 0.4 });
termIO.observe(document.querySelector('.terminal'));

// ---------- Skill bars fill on scroll ----------
const frames = document.querySelectorAll('.frame-item');
const frameIO = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting){
      const fill = entry.target.querySelector('.frame-fill');
      fill.style.width = entry.target.getAttribute('data-level') + '%';
      frameIO.unobserve(entry.target);
    }
  });
}, { threshold: 0.5 });
frames.forEach(f => frameIO.observe(f));

// ---------- Cert badge reveal ----------
const badge = document.querySelector('.badge');
const badgeIO = new IntersectionObserver((entries) => {
  entries.forEach(entry => { if (entry.isIntersecting) badge.classList.add('in'); });
}, { threshold: 0.5 });
badgeIO.observe(badge);
</script>

