<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vignesh Kumar S — Software Developer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;600;700;900&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<style>
  :root{
    --black: #050303;
    --char: #0d0808;
    --panel: #130a0a;
    --line: #2b1414;
    --crimson: #d81324;
    --ember: #ff4b3e;
    --brass: #c9a24b;
    --bone: #f3ece6;
    --bone-dim: #a99c96;
    --display: 'Unbounded', sans-serif;
    --body: 'Inter', sans-serif;
    --mono: 'JetBrains Mono', monospace;
  }

  *{margin:0; padding:0; box-sizing:border-box;}
  html{scroll-behavior:smooth;}

  body{
    background: var(--black);
    color: var(--bone);
    font-family: var(--body);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x:hidden;
  }

  ::selection{ background: var(--crimson); color: var(--black); }

  a{ color:inherit; text-decoration:none; }

  h1,h2,h3{ font-family: var(--display); letter-spacing:-0.01em; }

  #bg-canvas{
    position:fixed; inset:0; z-index:0; opacity:.55;
    pointer-events:none;
  }

  .glow{
    position:fixed; width:520px; height:520px; border-radius:50%;
    background: radial-gradient(circle, rgba(216,19,36,.35), transparent 70%);
    pointer-events:none; z-index:1; filter:blur(10px);
    transform:translate(-50%,-50%);
    transition: opacity .3s ease;
  }

  /* ---- rail nav ---- */
  .rail{
    position:fixed; right:28px; top:50%; transform:translateY(-50%);
    display:flex; flex-direction:column; gap:16px; z-index:50;
  }
  .rail a{
    width:9px; height:9px; border-radius:50%;
    background: var(--line);
    display:block; position:relative;
    transition: background .3s ease, transform .3s ease;
  }
  .rail a.active{ background: var(--ember); transform:scale(1.35); }
  .rail a::after{
    content: attr(data-label);
    position:absolute; right:22px; top:50%; transform:translateY(-50%);
    font-family:var(--mono); font-size:.7rem; color:var(--bone-dim);
    white-space:nowrap; opacity:0; transition:opacity .25s ease;
  }
  .rail a:hover::after{ opacity:1; }
  @media (max-width:900px){ .rail{ display:none; } }

  section{ position:relative; z-index:2; padding: 8vw 8vw; }

  /* ---- HERO ---- */
  .hero{
    min-height:100svh; display:flex; flex-direction:column; justify-content:center;
    padding-top:0;
  }
  .status-pill{
    display:inline-flex; align-items:center; gap:10px;
    font-family:var(--mono); font-size:.78rem; color:var(--bone-dim);
    border:1px solid var(--line); padding:7px 14px; border-radius:2px;
    width:fit-content; margin-bottom:2.4rem;
    clip-path: polygon(0 0, 100% 0, 100% 70%, 96% 100%, 0 100%);
  }
  .status-dot{
    width:8px; height:8px; border-radius:50%; background:var(--ember);
    box-shadow:0 0 0 0 rgba(255,75,62,.6);
    animation: pulse 1.8s infinite;
  }
  @keyframes pulse{
    0%{ box-shadow:0 0 0 0 rgba(255,75,62,.55); }
    70%{ box-shadow:0 0 0 9px rgba(255,75,62,0); }
    100%{ box-shadow:0 0 0 0 rgba(255,75,62,0); }
  }

  .hero-name{
    font-size: clamp(3.2rem, 10vw, 8.4rem);
    font-weight:900; line-height:.92; text-transform:uppercase;
    display:flex; flex-wrap:wrap;
  }
  .hero-name .word{ display:inline-flex; overflow:hidden; margin-right:.28em;}
  .hero-name .char{
    display:inline-block;
    transform: translateY(115%);
    animation: rise .8s cubic-bezier(.2,.9,.2,1) forwards;
  }
  .hero-name .word:nth-child(2) .char{ color: var(--crimson); -webkit-text-stroke: 1px var(--ember); }
  @keyframes rise{ to{ transform: translateY(0); } }

  .hero-sub{
    margin-top:1.6rem; max-width:640px;
    font-size:clamp(1.05rem,1.6vw,1.35rem); color:var(--bone-dim);
    font-weight:400; line-height:1.55;
    opacity:0; animation: fadeUp 1s ease .9s forwards;
  }
  .hero-sub strong{ color:var(--bone); font-weight:600; }
  @keyframes fadeUp{ from{opacity:0; transform:translateY(14px);} to{opacity:1; transform:translateY(0);} }

  .hero-tags{
    margin-top:2.2rem; display:flex; gap:.6rem; flex-wrap:wrap;
    opacity:0; animation: fadeUp 1s ease 1.15s forwards;
  }
  .hero-tags span{
    font-family:var(--mono); font-size:.72rem; color:var(--brass);
    border:1px solid rgba(201,162,75,.35); padding:6px 12px;
  }

  .scroll-cue{
    position:absolute; bottom:38px; left:8vw;
    font-family:var(--mono); font-size:.7rem; color:var(--bone-dim);
    display:flex; align-items:center; gap:10px;
  }
  .scroll-cue .bar{ width:1px; height:34px; background:var(--line); position:relative; overflow:hidden; }
  .scroll-cue .bar::after{
    content:''; position:absolute; top:-100%; left:0; width:100%; height:100%;
    background:var(--ember); animation: fall 1.8s ease-in-out infinite;
  }
  @keyframes fall{ 0%{top:-100%;} 60%{top:100%;} 100%{top:100%;} }

  /* ---- section headers ---- */
  .kicker{
    font-family:var(--mono); font-size:.78rem; color:var(--ember);
    display:flex; align-items:center; gap:10px; margin-bottom:1.1rem;
  }
  .kicker::before{ content:''; width:26px; height:1px; background:var(--ember); }
  .sec-title{
    font-size:clamp(2rem,4.4vw,3.4rem); font-weight:700; max-width:820px;
    line-height:1.08; margin-bottom:2.6rem;
  }

  .reveal{ opacity:0; transform:translateY(28px); transition: opacity .8s ease, transform .8s ease; }
  .reveal.in{ opacity:1; transform:translateY(0); }

  /* ---- ABOUT / TERMINAL ---- */
  .about{ display:grid; grid-template-columns: 1fr 1.2fr; gap:5vw; align-items:start; }
  @media (max-width:900px){ .about{ grid-template-columns:1fr; } }

  .about-copy p{ color:var(--bone-dim); line-height:1.75; margin-bottom:1.1rem; max-width:52ch; }
  .about-copy p strong{ color:var(--bone); font-weight:600; }

  .tilt-stage{ perspective: 1400px; }
  .terminal{
    background: var(--panel); border:1px solid var(--line);
    box-shadow: 0 30px 80px -30px rgba(216,19,36,.25);
    transform-style: preserve-3d;
    transform: rotateX(0deg) rotateY(0deg);
    transition: transform .4s cubic-bezier(.2,.9,.2,1);
    will-change: transform;
  }
  .term-top, .term-body{ transform: translateZ(18px); }
  .term-top{
    display:flex; align-items:center; gap:8px; padding:12px 16px;
    border-bottom:1px solid var(--line); font-family:var(--mono); font-size:.72rem; color:var(--bone-dim);
  }
  .term-top .dot{ width:9px; height:9px; border-radius:50%; }
  .term-top .dot:nth-child(1){ background:#5c2a2a; }
  .term-top .dot:nth-child(2){ background:#6b5a2a; }
  .term-top .dot:nth-child(3){ background:#2a5c3a; }
  .term-top span{ margin-left:auto; }
  .term-body{
    padding:24px; font-family:var(--mono); font-size:.88rem; line-height:1.9; min-height:260px;
    color: var(--bone-dim);
  }
  .term-body .line{ opacity:0; white-space:pre-wrap; }
  .term-body .prompt{ color:var(--ember); }
  .term-body .key{ color:var(--brass); }
  .term-body .val{ color:var(--bone); }
  .cursor-blink{
    display:inline-block; width:8px; height:1.1em; background:var(--ember);
    vertical-align:text-bottom; animation: blink 1s step-end infinite;
  }
  @keyframes blink{ 50%{ opacity:0; } }

  /* ---- SKILLS / STACK ---- */
  .stack-wrap{ display:grid; grid-template-columns: 1fr 1fr; gap:3.5rem; }
  @media (max-width:900px){ .stack-wrap{ grid-template-columns:1fr; } }

  .frame-item{ margin-bottom:1.8rem; }
  .frame-head{ display:flex; justify-content:space-between; font-family:var(--mono); font-size:.85rem; margin-bottom:.55rem; }
  .frame-head .lvl{ color:var(--ember); }
  .frame-track{ height:10px; background:var(--char); border:1px solid var(--line); position:relative; overflow:hidden; }
  .frame-fill{
    height:100%; width:0%;
    background: linear-gradient(90deg, var(--crimson), var(--ember));
    transition: width 1.4s cubic-bezier(.2,.9,.2,1);
  }
  .frame-fill::after{
    content:''; position:absolute; inset:0;
    background: repeating-linear-gradient(45deg, rgba(255,255,255,.08) 0 6px, transparent 6px 12px);
  }
  .frame-note{ font-size:.82rem; color:var(--bone-dim); margin-top:.5rem; max-width:44ch; }

  .qualities{ display:flex; flex-wrap:wrap; gap:.7rem; margin-top:.5rem; }
  .qualities span{
    font-family:var(--mono); font-size:.76rem; color:var(--bone);
    border:1px solid var(--line); padding:8px 14px;
    background: var(--char);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 6px 100%, 0 calc(100% - 6px));
  }

  /* ---- CERTIFICATION ---- */
  .cert-row{
    display:flex; align-items:center; gap:3rem; flex-wrap:wrap;
    border-top:1px solid var(--line); border-bottom:1px solid var(--line);
    padding:2.6rem 0;
  }
  .badge{
    width:140px; height:140px; flex-shrink:0;
    perspective: 900px;
    transform: scale(.4); opacity:0;
    transition: transform .9s cubic-bezier(.2,.9,.2,1), opacity .9s ease;
  }
  .badge.in{ transform: scale(1); opacity:1; }
  .coin{
    width:100%; height:100%; position:relative;
    transform-style: preserve-3d;
    animation: coinSpin 9s linear infinite;
  }
  .badge:hover .coin{ animation-play-state: paused; }
  @keyframes coinSpin{ from{ transform: rotateY(0deg); } to{ transform: rotateY(360deg); } }

  .coin-face{
    position:absolute; inset:0; border-radius:50%;
    backface-visibility:hidden;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px;
    background: radial-gradient(circle at 35% 30%, #1c0f0f, var(--panel) 70%);
    border:1.5px solid var(--brass);
    box-shadow: inset 0 0 24px rgba(0,0,0,.6), 0 18px 40px -18px rgba(216,19,36,.6);
  }
  .coin-face .brand{ font-family:var(--display); font-weight:700; font-size:.95rem; color:var(--bone); }
  .coin-face .tag{ font-family:var(--mono); font-size:.6rem; letter-spacing:.04em; color:var(--bone-dim); }
  .coin-face.back{
    transform: rotateY(180deg);
    border-color: var(--ember);
    background: radial-gradient(circle at 65% 70%, #1c0f0f, var(--panel) 70%);
  }
  .coin-face.back svg{ width:30px; height:30px; }

  .cert-text h3{ font-size:1.5rem; margin-bottom:.5rem; }
  .cert-text p{ color:var(--bone-dim); max-width:52ch; line-height:1.7; }

  /* ---- CTA ---- */
  .cta{
    text-align:left; padding-bottom:14vw;
  }
  .cta-title{
    font-size:clamp(2.2rem,6vw,5rem); font-weight:900; line-height:1.02; text-transform:uppercase;
    max-width:900px;
  }
  .cta-title em{ font-style:normal; color:var(--crimson); }
  .cta-row{ display:flex; gap:1rem; margin-top:2.6rem; flex-wrap:wrap; }
  .btn{
    font-family:var(--mono); font-size:.85rem; padding:14px 26px;
    border:1px solid var(--ember); position:relative; overflow:hidden;
  }
  .btn.primary{ background:var(--ember); color:var(--black); font-weight:600; }
  .btn.ghost{ color:var(--bone); }
  .btn span{ position:relative; z-index:2; }
  .btn.ghost::before{
    content:''; position:absolute; inset:0; background:var(--ember); transform:translateX(-101%);
    transition: transform .35s ease; z-index:1;
  }
  .btn.ghost:hover::before{ transform:translateX(0); }
  .btn.ghost:hover{ color:var(--black); }

  footer{
    position:relative; z-index:2; padding:2.4rem 8vw; border-top:1px solid var(--line);
    display:flex; justify-content:space-between; flex-wrap:wrap; gap:1rem;
    font-family:var(--mono); font-size:.74rem; color:var(--bone-dim);
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important; }
  }
</style>
</head>
<body>

